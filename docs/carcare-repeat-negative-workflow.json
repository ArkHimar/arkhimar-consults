ail) }}&location={{ encodeURIComponent($json.body.location) }}\" style=\"display:inline-block;padding:17px 26px;color:#071a17;font-size:12px;font-weight:800;letter-spacing:1.6px;text-decoration:none;text-transform:uppercase;\">Share your feedback&nbsp;&nbsp;&#8599;</a></td></tr></table></td></tr><tr><td style=\"padding:22px 32px 36px;\"><div style=\"border-left:4px solid #18a995;background:#e5f5ee;padding:16px 18px;\"><div style=\"color:#62716d;font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;\">Visit reference</div><div style=\"margin-top:6px;color:#0d2622;font-size:14px;font-weight:700;\">{{ $json.body.job_id }}</div></div><p style=\"margin:24px 0 0;color:#62716d;font-size:12px;line-height:1.6;\">Good, bad or somewhere in between—your words go directly to the service team. We never publish feedback automatically.</p></td></tr><tr><td style=\"background:#071512;padding:22px 32px;color:#ffffff;\"><div style=\"font-size:12px;font-weight:700;\">ArkHimar CarCare</div><div style=\"margin-top:7px;color:#9aaaa6;font-size:11px;line-height:1.5;\">A secure feedback experience by ArkHimar Consult.</div></td></tr></table><div style=\"max-width:620px;padding:16px 8px;color:#62716d;font-size:10px;line-height:1.5;text-align:center;\">If the button does not work, copy this address into your browser:<br><span style=\"word-break:break-all;\">https://www.arkhimar.com/carcare</span></div></td></tr></table></div>",
